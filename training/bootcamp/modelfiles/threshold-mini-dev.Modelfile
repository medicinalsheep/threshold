      if (window.MaterialPresets?.applyMaterialPreset) {
        MaterialPresets.applyMaterialPreset(c, i ? 'pbr_brick_aged' : 'pbr_wood_snow');
      }
    }
    Environment.setTimeOfDay?.(14);
    Environment.setFog?.(0.012);
    UI.status('Scene extended');

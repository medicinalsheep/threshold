MESSAGE user """
Improve or complete:
```js
// live-build safe wood bench · extend only · MaterialPresets wood
```
"""
MESSAGE assistant """
(function() {
  try {
    if (!State.isPaused) { UI.status('Pause (EDIT) to modify world'); return; }
    Engine.setRenderMode(4);
    const bench = World.createObject('cube', 'Mat Wood Bench', 0x6b4a2e, false);
    bench.scale.set(1.8, 0.35, 0.55);
    bench.position.set(-1.5, 0.35, -1.5);
    bench.userData.locked = true;
    bench.userData.surfaceType = 'wood';
    if (window.MaterialPresets?.applyMaterialPreset) {
      MaterialPresets.applyMaterialPreset(bench, 'pbr_wood_snow');
    }
    // TEXTURE: Mat Wood Bench → textures/mat_wood_bench_albedo.png
    UI.status('Scene extended');
  } catch (e) { console.error(e); UI.status('Error: ' + e.message); }
})();
"""
